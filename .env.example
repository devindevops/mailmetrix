# MailMetrix backend configuration
# Keep this file free of real credentials and secrets.

# Port on which the backend server listens inside its container.
PORT=4000
RATE_LIMIT_BLACKLIST=30
RATE_LIMIT_SCORE=15
RATE_LIMIT_TLS=20
RATE_LIMIT_SHARE=60
SHARE_TTL_DAYS=1

## Optional Variables for Share
SHARE_PER_IP_DAILY=30
SHARE_MAX_TOTAL_MB=512
SHARE_MAX_FILES=5000

## Optional Variables for Score
SCORE_CACHE_TTL_SECONDS=300
SCORE_TARGET_TTL_SECONDS=900
SCORE_MAX_DNS_QUERIES=80
SCORE_DEADLINE_SECONDS=25
SCORE_MAX_CONCURRENT=8
SCORE_MAX_QUEUE=16
SCORE_DNSBL_IPS_PER_HOUR=300
SCORE_TLS_PROBES_PER_HOUR=120

# NOTE FOR CLOUD / VPS DEPLOYMENTS:
# 1. Port 25 Outbound: Cloud providers (AWS, GCP, DigitalOcean, Linode, Hetzner) block outbound
#    port 25 by default. Contact your provider to unblock port 25 if live mail server TLS checks fail.
# 2. DNSBL / Blacklist checks: Public DNS resolvers (8.8.8.8, 1.1.1.1) are blocked by Spamhaus
#    and Barracuda. For accurate blacklist checks, configure your VPS host to use a local
#    recursive resolver (e.g. Unbound / Bind) instead of public open resolvers.